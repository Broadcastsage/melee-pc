     lbVector_Diff(arg1, &fp->cur_pos, &diff);
 
@@ -456,6 +462,113 @@ void ftBossLib_8015CC14(void)
 
 #ifdef TARGET_PC
 #include <sysdolphin/baselib/controller.h>
+#include <melee/mn/mnsecretchar.h>
+#include "pc/pc.h"
+
+/// How far above its spawn point a VS hand floats.
+#define BOSS_HAND_HOVER 40.0f
+
+typedef struct BossHandOffset {
+    bool active;
+    float fd_home_x, fd_home_y; ///< home in the hand's own data
+    float base_x, base_y;       ///< offset for the spawn-point home
+    float x, y;                 ///< current offset
+    int log_timer;
+} BossHandOffset;
+
+static BossHandOffset hand_offset[6];
+
+static BossHandOffset* hand_of(HSD_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    if (fp->player_idx < 0 || fp->player_idx >= 6 || fp->is_sub_fighter) {
+        return NULL;
+    }
+    return &hand_offset[fp->player_idx];
+}
+
+void ftBossLib_HandInit(HSD_GObj* gobj, float fd_home_x, float fd_home_y)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    BossHandOffset* h = hand_of(gobj);
+    Vec3 spawn;
+
+    if (h == NULL) {
+        return;
+    }
+    h->active = mnSecret_IsVsHand(fp->player_idx);
+    h->fd_home_x = fd_home_x;
+    h->fd_home_y = fd_home_y;
+    h->base_x = h->base_y = h->x = h->y = 0.0f;
+    h->log_timer = 0;
+    if (!h->active) {
+        return;
+    }
+    Player_LoadPlayerCoords(fp->player_idx, &spawn);
+    /* Stages are centred like Final Destination, so a CPU hand keeps the
+     * data's x; a human hand starts above its own spawn point. */
+    h->base_y = spawn.y + BOSS_HAND_HOVER - fd_home_y;
+    h->base_x = 0.0f;
+    h->x = Player_GetPlayerSlotType(fp->player_idx) == Gm_PKind_Human
+               ? spawn.x - fd_home_x
+               : 0.0f;
+    h->y = h->base_y;
+    pc_log_line("bosshand: init p%d kind %d stage %d spawn (%.1f, %.1f) "
+                "fd_home (%.1f, %.1f) offset (%.1f, %.1f) human %d",
+                fp->player_idx, fp->kind, (int) Stage_80225194(), spawn.x,
+                spawn.y, fd_home_x, fd_home_y, h->x, h->y,
+                Player_GetPlayerSlotType(fp->player_idx) == Gm_PKind_Human);
+}
+
+void ftBossLib_HandAnchorHere(HSD_GObj* gobj, bool sweep)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    BossHandOffset* h = hand_of(gobj);
+
+    if (h == NULL || !h->active) {
+        return;
+    }
+    if (sweep) {
+        h->x = 0.0f;
+        h->y = h->base_y;
+    } else {
+        h->x = fp->cur_pos.x - h->fd_home_x;
+        h->y = fp->cur_pos.y - h->fd_home_y;
+    }
+}
+
+float ftBossLib_HandX(HSD_GObj* gobj, float fd_x)
+{
+    BossHandOffset* h = hand_of(gobj);
+    return (h != NULL && h->active) ? fd_x + h->x : fd_x;
+}
+
+float ftBossLib_HandY(HSD_GObj* gobj, float fd_y)
+{
+    BossHandOffset* h = hand_of(gobj);
+    return (h != NULL && h->active) ? fd_y + h->y : fd_y;
+}
+
+void ftBossLib_HandLog(HSD_GObj* gobj, const char* what)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    BossHandOffset* h = hand_of(gobj);
+
+    if (h == NULL || !h->active) {
+        return;
+    }
+    if (what == NULL) {
+        if (++h->log_timer < 180) {
+            return;
+        }
+        h->log_timer = 0;
+        what = "tick";
+    }
+    pc_log_line("bosshand: %s p%d motion %d pos (%.1f, %.1f) offset (%.1f, "
+                "%.1f)",
+                what, fp->player_idx, (int) fp->motion_id, fp->cur_pos.x,
+                fp->cur_pos.y, h->x, h->y);
+}
 
 /// Stick deflection that counts as a direction for a hand's attack.
 #define BOSS_HUMAN_TILT 0.5f
@@ -542,6 +655,11 @@ void ftBossLib_HumanMove(HSD_GObj* gobj)
     }
     fp->self_vel.x += vx;
     fp->self_vel.y += vy;
+    /* The wait animation re-pins the hand to u.mh.x2240_pos each loop;
+     * follow the stick instead of snapping back. */
+    fp->u.mh.x2240_pos.x = fp->cur_pos.x + fp->self_vel.x;
+    fp->u.mh.x2240_pos.y = fp->cur_pos.y + fp->self_vel.y;
+    ftBossLib_HandLog(gobj, NULL);
 }
 
 void ftBossLib_HumanTargetX(HSD_GObj* gobj, Vec3* pos)
diff --git a/src/melee/ft/ftbosslib.h b/src/melee/ft/ftbosslib.h
index aad491f..dfe5b70 100644
