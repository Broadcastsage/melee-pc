+bool mnSecret_IsVsHand(int player)
+{
+    /* The swap record outlives the VS session (it is only cleared on the
+     * next CSS entry), so also require a VS-style mode: a Classic-mode
+     * boss in the same slot must keep its own coordinates. */
+    switch (gm_GetCurrentGameMode()) {
+    case GM_VS:
+    case GM_SUPER_SUDDEN_DEATH_VS:
+    case GM_INVISIBLE_VS:
+    case GM_SLOMO_VS:
+    case GM_LIGHTNING_VS:
+    case GM_TINY_VS:
+    case GM_GIANT_VS:
+    case GM_STAMINA_VS:
+    case GM_CAMERA_VS:
+    case GM_SINGLE_BUTTON_VS:
+        break;
+    default:
+        return false;
+    }
+    return valid_player(player) && slots[player].applied &&
+           is_hand(slots[player].secret);
+}
