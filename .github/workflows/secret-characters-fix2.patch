 void ftBossLib_HumanMove(HSD_GObj* gobj);
 void ftBossLib_HumanTargetX(HSD_GObj* gobj, Vec3* pos);
+
+/* Master/Crazy Hand picked in VS. Their data places everything (entrance,
+ * home, attack targets) at fixed Final Destination coordinates. A per-hand
+ * offset maps that layout onto the current stage: a CPU hand's home moves
+ * above its spawn point; a human hand's home is wherever the attack
+ * started, so attacks happen relative to the hand and it comes back there.
+ * The offset is zero for every other fighter, so Classic mode is unchanged.
+ * @p fd_home is the hand's home in its own data. */
+void ftBossLib_HandInit(HSD_GObj* gobj, float fd_home_x, float fd_home_y);
+/// A human hand starting an attack: re-anchor its offset (@p sweep keeps
+/// floor-relative x for the attacks that slide in from a floor edge).
+void ftBossLib_HandAnchorHere(HSD_GObj* gobj, bool sweep);
+float ftBossLib_HandX(HSD_GObj* gobj, float fd_x);
+float ftBossLib_HandY(HSD_GObj* gobj, float fd_y);
+/// Periodic position line in melee-pc.log for VS hands.
+void ftBossLib_HandLog(HSD_GObj* gobj, const char* what);
+#else
+#define ftBossLib_HandX(gobj, x) (x)
+#define ftBossLib_HandY(gobj, y) (y)
 #endif
 
 #endif
