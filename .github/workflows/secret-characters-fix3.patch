diff --git a/src/melee/mn/mnsecretchar.c b/src/melee/mn/mnsecretchar.c
index 0488b37..c4d3994 100644
--- a/src/melee/mn/mnsecretchar.c
+++ b/src/melee/mn/mnsecretchar.c
@@ -54,6 +54,8 @@ static const SecretTile tiles[MNSECRET_TILE_COUNT] = {
 /// Master Hand and Crazy Hand get this much HP outside Stamina mode, the
 /// same as Classic mode gives them; otherwise nothing could KO them.
 #define SECRET_HAND_HP 300
+/// A hand's HP in sudden death.
+#define SECRET_HAND_SD_HP 40
 
 typedef struct SecretSlot {
     s8 secret;           ///< ::CharacterKind, or -1
@@ -332,4 +334,56 @@ void mnSecret_RemapMatchEnd(MatchEnd* end)
     }
 }
 
+void mnSecret_UnmapMatchEnd(MatchEnd* end)
+{
+    int i;
+
+    for (i = 0; i < GM_MAX_PLAYERS; i++) {
+        struct MatchPlayerData* pd = &end->player_standings[i];
+        SecretSlot* s = &slots[i];
+
+        if (pd->pkind == Gm_PKind_NA || !s->applied || s->secret < 0 ||
+            pd->ckind != s->base)
+        {
+            continue;
+        }
+        pd->ckind = s->secret;
+        switch (s->secret) {
+        case CKind_MasterH:
+            pd->ftkind = Ft_Kind_MasterH;
+            break;
+        case CKind_CrezyH:
+            pd->ftkind = Ft_Kind_CrezyH;
+            break;
+        case CKind_GKoops:
+            pd->ftkind = Ft_Kind_GKoops;
+            break;
+        case CKind_Boy:
+            pd->ftkind = Ft_Kind_Boy;
+            break;
+        case CKind_Girl:
+            pd->ftkind = Ft_Kind_Girl;
+            break;
+        case ChKind_Sandbag:
+            pd->ftkind = Ft_Kind_Sandbag;
+            break;
+        }
+    }
+}
+
+void mnSecret_AdjustSuddenDeath(StartMeleeData* start)
+{
+    int i;
+
+    for (i = 0; i < GM_MAX_PLAYERS; i++) {
+        PlayerInitData* p = &start->players[i];
+        if (p->slot_type != Gm_PKind_NA && is_hand(p->ckind)) {
+            p->xC_b7 = true;
+            p->hp = SECRET_HAND_SD_HP;
+            p->damage = 0;
+            p->damage1 = 0;
+        }
+    }
+}
+
 #endif
diff --git a/src/melee/mn/mnsecretchar.h b/src/melee/mn/mnsecretchar.h
index 2c6682d..6834c5f 100644
--- a/src/melee/mn/mnsecretchar.h
+++ b/src/melee/mn/mnsecretchar.h
@@ -72,6 +72,14 @@ bool mnSecret_IsVsHand(int player);
 /// After a match: report secret characters as their base character.
 void mnSecret_RemapMatchEnd(MatchEnd* end);
 
+/// Undo mnSecret_RemapMatchEnd, so sudden death (which takes each player's
+/// character from these standings) gets the secret characters back.
+void mnSecret_UnmapMatchEnd(MatchEnd* end);
+
+/// Sudden death gives everyone 300%. A hand plays on HP, so give it a small
+/// HP pool instead (300% would leave it at 0 HP).
+void mnSecret_AdjustSuddenDeath(StartMeleeData* start);
+
 #endif
 
 #endif
