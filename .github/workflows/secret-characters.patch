+/// Stick deflection that counts as a direction for a hand's attack.
+#define BOSS_HUMAN_TILT 0.5f
+/// Distance the hand travels per frame at full stick deflection.
+#define BOSS_HUMAN_SPEED 1.1f
+/// How far inside the camera bounds the hand is kept.
+#define BOSS_HUMAN_MARGIN 10.0f
+
+u32 ftBossLib_HumanComboButtons(HSD_GObj* gobj, bool fallback)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    u32 pressed = fp->input.pressed_buttons;
+    u32 held = fp->input.held_buttons[0];
+    u32 combo = 0;
+    float sx = fp->input.lstick[0].x;
+    float sy = fp->input.lstick[0].y;
+
+    if (pressed & HSD_PAD_A) {
+        combo = HSD_PAD_A;
+    } else if (pressed & HSD_PAD_B) {
+        combo = HSD_PAD_B;
+    } else if (pressed & (HSD_PAD_Z | HSD_PAD_X)) {
+        combo = HSD_PAD_Z;
+    } else if (pressed & HSD_PAD_Y) {
+        combo = HSD_PAD_Y;
+    } else if (pressed & HSD_PAD_L) {
+        combo = HSD_PAD_L;
+    } else if (pressed & HSD_PAD_R) {
+        combo = HSD_PAD_R;
+    }
+    if (combo == 0) {
+        return 0;
+    }
+
+    /* A D-pad direction held with the button wins, which keeps the
+     * original debug combos working; otherwise the stick picks it. */
+    if (!fallback && (held & (HSD_PAD_DPADUP | HSD_PAD_DPADDOWN |
+                              HSD_PAD_DPADLEFT | HSD_PAD_DPADRIGHT)))
+    {
+        return combo | (held & (HSD_PAD_DPADUP | HSD_PAD_DPADDOWN |
+                                HSD_PAD_DPADLEFT | HSD_PAD_DPADRIGHT));
+    }
+    if (fallback) {
+        /* No move on that direction: the forward one exists for every
+         * button, so retry with it. */
+        return combo | HSD_PAD_DPADRIGHT;
+    }
+    if (ABS(sy) >= ABS(sx) && sy > BOSS_HUMAN_TILT) {
+        return combo | HSD_PAD_DPADUP;
+    }
+    if (ABS(sy) >= ABS(sx) && sy < -BOSS_HUMAN_TILT) {
+        return combo | HSD_PAD_DPADDOWN;
+    }
+    if (sx < -BOSS_HUMAN_TILT) {
+        return combo | HSD_PAD_DPADLEFT;
+    }
+    return combo | HSD_PAD_DPADRIGHT;
+}
+
+void ftBossLib_HumanMove(HSD_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    float sx = fp->input.lstick[0].x;
+    float sy = fp->input.lstick[0].y;
+    float left = Stage_GetCamBoundsLeftOffset() + BOSS_HUMAN_MARGIN;
+    float right = Stage_GetCamBoundsRightOffset() - BOSS_HUMAN_MARGIN;
+    float top = Stage_GetCamBoundsTopOffset() - BOSS_HUMAN_MARGIN;
+    float bottom = Stage_GetCamBoundsBottomOffset() + BOSS_HUMAN_MARGIN;
+    float vx = 0.0f;
+    float vy = 0.0f;
+
+    if (ABS(sx) > 0.2f) {
+        vx = sx * BOSS_HUMAN_SPEED;
+    }
+    if (ABS(sy) > 0.2f) {
+        vy = sy * BOSS_HUMAN_SPEED;
+    }
+    /* Never push further out; always allow coming back in. */
+    if ((fp->cur_pos.x <= left && vx < 0) || (fp->cur_pos.x >= right && vx > 0)) {
+        vx = 0.0f;
+    }
+    if ((fp->cur_pos.y <= bottom && vy < 0) || (fp->cur_pos.y >= top && vy > 0)) {
+        vy = 0.0f;
+    }
+    fp->self_vel.x += vx;
+    fp->self_vel.y += vy;
+}
+
+void ftBossLib_HumanTargetX(HSD_GObj* gobj, Vec3* pos)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    pos->x = fp->cur_pos.x;
+}
