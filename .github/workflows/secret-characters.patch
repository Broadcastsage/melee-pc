+static bool mnCharSel_SelectSecretTile(u8 door, struct CSSCursorData* cursor,
+                                       int tile)
+{
+    int player = getPlayerForDoor(door);
+    int base;
+    s32 i;
+
+    if (tile < 0 || player < 0 || player >= 4) {
+        return false;
+    }
+    base = mnSecret_TileBase(tile);
+    for (i = 0; i < 0x19; i++) {
+        if (icons[i].char_kind == base) {
+            break;
+        }
+    }
+    if (i >= 0x19) {
+        return false;
+    }
+
+    mnSecret_SelectTile(player, tile);
+    mnCharSel_804D6CB0->vs.start.players[player].ckind = (s8) base;
+    mnCharSel_803F0DFC.doors[door].sel_icon = (u8) i;
+    mnCharSel_8025DB34(door);
+
+    mnCharSel_804A0BD0[door]->x5 = 0;
+    HSD_GObjGXLink_803909D8(mnCharSel_804A0BD0[door]->gobj,
+                            mnCharSel_804A0BC0[mnCharSel_804D6CF5 - 1]->gobj);
+    mnCharSel_803F0DFC.doors[door].selected_since_load = 1;
+    cursor->x5 = 2;
