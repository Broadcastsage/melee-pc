+/* Quick attacks: hitboxes made directly (the way a move script's hitbox
+ * command does) while the hand stays in its wait state, so they come out
+ * fast instead of through a boss attack's long wind-up. */
+#define QUICK_JAB 1
+#define QUICK_SWIPE 2
+
+typedef struct QuickMove {
+    int frames;       ///< total length (the cooldown is the tail)
+    int hit_start, hit_end;
+    int damage;
+    float size;
+    int angle, kbg, bkb;
+    float lunge;      ///< speed of the dash during the active frames
+} QuickMove;
+
+static const QuickMove quick_moves[3] = {
+    { 0 },
+    /* Jab: fast poke in the stick's direction. */
+    { 14, 1, 6, 6, 9.0f, 50, 60, 20, 2.4f },
+    /* Swipe: slower, wider, sends people flying. */
+    { 26, 6, 13, 12, 13.0f, 40, 90, 35, 1.3f },
+};
+
+static void quick_hitbox_on(HSD_GObj* gobj, BossHandOffset* h,
+                            const QuickMove* q)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    HitCapsule* hit = &fp->x914[0];
+
+    h->quick_group++;
+    hit->x4 = h->quick_group;
+    hit->state = HitCapsule_Enabled;
+    fp->x2219_b3 = 1;
+    ftColl_800768A0(fp, hit);
+    hit->jobj = fp->parts[FtPart_WaistN].joint;
+    ftColl_8007ABD0(hit, q->damage, gobj);
+    hit->scale = q->size;
+    hit->b_offset.x = hit->b_offset.y = hit->b_offset.z = 0.0f;
+    ftColl_8007AC9C(hit, q->angle, gobj);
+    hit->x24 = q->kbg;
+    hit->x28 = 0;
+    hit->x43_b0 = 1;
+    hit->x43_b1 = 1; // size in world units, not scaled by the hand's model
+    hit->x40_b0 = 0;
+    hit->x40_b1 = 0;
+    hit->x2C = q->bkb;
+    hit->element = 0;
+    hit->x34 = 0;
+    hit->sfx_severity = q->damage >= 10 ? 2 : 1;
+    hit->sfx_kind = 0;
+    hit->x40_b2 = 1;
+    hit->x40_b3 = 1;
+    hit->x42_b5 = 1;
+    hit->x42_b7 = 1;
+    hit->x41_b4 = 0;
+    hit->x41_b6 = 0;
+    hit->x41_b5 = 0;
+    hit->x42_b0 = 0;
+    hit->x42_b4 = 0;
+    hit->x41_b7 = 0;
+    hit->x134.hit_grabbed_victim_only = 0;
+    hit->x42_b1 = 1;
+    hit->x42_b2 = 0;
+    hit->x43_b2 = 0;
+    if (HSD_GObj_CurrentInvokedProc != NULL &&
+        HSD_GObj_CurrentInvokedProc->s_link > 9)
+    {
+        ftColl_8007AD18(fp, hit);
+    }
+}
+
+static void quick_cancel(HSD_GObj* gobj, BossHandOffset* h)
+{
+    if (h->quick_kind != 0) {
+        ftColl_8007AFF8(gobj);
+        h->quick_kind = 0;
+        h->quick_frame = 0;
+    }
+}
+
+static bool hand_is_waiting(Fighter* fp)
+{
+    return fp->motion_id == 341 || fp->motion_id == 342; // Wait1_0 / Wait2_0
+}
+
+/// A or B in the wait state: start a quick attack. Returns true if one
+/// started (or one is still running, which blocks other attacks).
+static bool quick_try(HSD_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    BossHandOffset* h = hand_of(gobj);
+    u32 pressed = fp->input.pressed_buttons;
+    float sx = fp->input.lstick[0].x;
+    float sy = fp->input.lstick[0].y;
+    float len;
+
+    if (h == NULL || !h->active || !h->human) {
+        return false;
+    }
+    if (h->quick_kind != 0) {
+        return true;
+    }
+    if (!(pressed & (HSD_PAD_A | HSD_PAD_B)) || !hand_is_waiting(fp)) {
+        return false;
+    }
+    h->quick_kind = (pressed & HSD_PAD_A) ? QUICK_JAB : QUICK_SWIPE;
+    h->quick_frame = 0;
+    len = sqrtf(sx * sx + sy * sy);
+    if (len > 0.3f) {
+        h->quick_dx = sx / len;
+        h->quick_dy = sy / len;
+    } else {
+        h->quick_dx = h->facing;
+        h->quick_dy = 0.0f;
+    }
+    return true;
+}
+
+static void quick_frame(HSD_GObj* gobj, BossHandOffset* h)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    const QuickMove* q;
+
+    if (h->quick_kind == 0) {
+        return;
+    }
+    if (!hand_is_waiting(fp)) {
+        /* Hit, grabbed, or a big attack started: drop the quick one. */
+        quick_cancel(gobj, h);
+        return;
+    }
+    q = &quick_moves[h->quick_kind];
+    h->quick_frame++;
+    if (h->quick_frame == q->hit_start) {
+        quick_hitbox_on(gobj, h, q);
+    }
+    if (h->quick_frame >= q->hit_start && h->quick_frame <= q->hit_end) {
+        fp->self_vel.x += h->quick_dx * q->lunge;
+        fp->self_vel.y += h->quick_dy * q->lunge;
+    }
+    if (h->quick_frame == q->hit_end + 1) {
+        ftColl_8007AFF8(gobj);
+    }
+    if (h->quick_frame >= q->frames) {
+        h->quick_kind = 0;
+        h->quick_frame = 0;
+    }
+}
+
+/// How long a human hand may stay out of its wait state before it is
+/// assumed stuck (a grab with nobody to hold, an attack waiting on a
+/// stage the data never expected...).
+#define HAND_STUCK_FRAMES (7 * 60)
+
+static void hand_unstick(HSD_GObj* gobj, BossHandOffset* h)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+
+    pc_log_line("bosshand: unstick p%d from motion %d at (%.1f, %.1f)",
+                fp->player_idx, (int) fp->motion_id, fp->cur_pos.x,
+                fp->cur_pos.y);
+    if (fp->victim_gobj != NULL) {
+        Fighter* vp = GET_FIGHTER(fp->victim_gobj);
+        vp->invisible = false;
+        ftCo_CaptureCut_Enter(fp->victim_gobj);
+    }
+    ftColl_8007AFF8(gobj);
+    fp->u.mh.x2258 = 341;
+    Fighter_ChangeMotionState(gobj, 341, Ft_MF_None, 0.0f, 1.0f, 0.0f, NULL);
+    ftAnim_8006EBA4(gobj);
+    fp->self_vel.x = fp->self_vel.y = fp->self_vel.z = 0.0f;
+    fp->u.mh.x2240_pos = fp->cur_pos;
+    ftBossLib_8015C09C(gobj, h->facing);
+    h->sweep = h->mirror = false;
+    h->stuck_frames = 0;
+}
+
+void ftBossLib_HandFrame(HSD_GObj* gobj)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    BossHandOffset* h = hand_of(gobj);
+    int motion;
+
+    if (h == NULL || !h->active) {
+        return;
+    }
+    motion = (int) fp->motion_id;
+    if (motion != h->prev_motion) {
+        pc_log_line("bosshand: p%d motion %d -> %d at (%.1f, %.1f)",
+                    fp->player_idx, h->prev_motion, motion, fp->cur_pos.x,
+                    fp->cur_pos.y);
+        h->prev_motion = motion;
+    }
+    if (!h->human) {
+        return;
+    }
+    if (hand_is_waiting(fp)) {
+        /* Back in the wait state: the last attack's sweep/mirror no longer
+         * applies, so the stick can turn the hand again. */
+        h->sweep = h->mirror = false;
+    }
+    quick_frame(gobj, h);
+    /* 341/342 wait, 343 entrance, 344/345 the KO sequence; 0-11 are the
+     * common KO states and Sleep (waiting to respawn, or out of the
+     * match), which must never be "unstuck". */
+    if ((motion >= 341 && motion <= 345) || motion <= 11) {
+        h->stuck_frames = 0;
+    } else if (++h->stuck_frames > HAND_STUCK_FRAMES) {
+        hand_unstick(gobj, h);
+    }
+}
