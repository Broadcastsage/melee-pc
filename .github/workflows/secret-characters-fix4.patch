+static float hand_facing_override(HSD_GObj* gobj, float requested)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    BossHandOffset* h = hand_of(gobj);
+
+    /* The attacks set the data's facing; a human hand keeps the player's
+     * (sweeps excepted, see ftBossLib_HandAnchorHere). */
+    if (h == NULL || !h->active || !h->human) {
+        return requested;
+    }
+    return h->sweep ? natural_facing(fp) : h->facing;
+}
