+/// Final Destination's main floor: x +-85.5657 at y 0, the layout every
+/// hand attack was designed around.
+#define FD_FLOOR_EDGE 85.5657f
+
+void ftBossLib_FloorRight(HSD_GObj* gobj, Vec3* out)
+{
+    BossHandOffset* h = hand_of(gobj);
+    if (h == NULL || !h->active) {
+        mpFloorGetRight(0, out);
+        return;
+    }
+    /* Floor line 0 is Final Destination's main floor; on other stages it can
+     * be anything (a far-off ledge), so map FD's edge instead. Mirrored, the
+     * right edge lands on the hand's other side, as it should. */
+    out->x = ftBossLib_HandX(gobj, FD_FLOOR_EDGE);
+    out->y = ftBossLib_HandY(gobj, 0.0f);
+    out->z = 0.0f;
+}
+
+void ftBossLib_FloorLeft(HSD_GObj* gobj, Vec3* out)
+{
+    BossHandOffset* h = hand_of(gobj);
+    if (h == NULL || !h->active) {
+        mpFloorGetLeft(0, out);
+        return;
+    }
+    out->x = ftBossLib_HandX(gobj, -FD_FLOOR_EDGE);
+    out->y = ftBossLib_HandY(gobj, 0.0f);
+    out->z = 0.0f;
+}
+
+/* The same edges in Final Destination's own coordinates, for attack start
+ * points: those go to the glide (ftBossLib_8015BE40), which maps them. */
+void ftBossLib_FloorRightFD(HSD_GObj* gobj, Vec3* out)
+{
+    BossHandOffset* h = hand_of(gobj);
+    if (h == NULL || !h->active) {
+        mpFloorGetRight(0, out);
+        return;
+    }
+    out->x = FD_FLOOR_EDGE;
+    out->y = 0.0f;
+    out->z = 0.0f;
+}
+
+void ftBossLib_FloorLeftFD(HSD_GObj* gobj, Vec3* out)
+{
+    BossHandOffset* h = hand_of(gobj);
+    if (h == NULL || !h->active) {
+        mpFloorGetLeft(0, out);
+        return;
+    }
+    out->x = -FD_FLOOR_EDGE;
+    out->y = 0.0f;
+    out->z = 0.0f;
+}
+
+bool ftBossLib_PastEdge(HSD_GObj* gobj, float edge_x, bool left_edge)
+{
+    Fighter* fp = GET_FIGHTER(gobj);
+    BossHandOffset* h = hand_of(gobj);
+    /* A mirrored hand travels the other way, so "past the left edge" is
+     * past it to the right. */
+    bool leftward = left_edge;
+    if (h != NULL && h->active && h->mirror) {
+        leftward = !leftward;
+    }
+    return leftward ? fp->cur_pos.x < edge_x : fp->cur_pos.x > edge_x;
+}
+
+/// Glide to an attack's start position this much faster for a human hand.
+#define HAND_GLIDE_BOOST 3.0f
+/// Big attacks play this much faster for a human hand.
+#define HAND_ATTACK_SPEED 1.5f
+
+float ftBossLib_HandGlideRate(HSD_GObj* gobj, float rate)
+{
+    BossHandOffset* h = hand_of(gobj);
+    if (h == NULL || !h->active || !h->human) {
+        return rate;
+    }
+    rate *= HAND_GLIDE_BOOST;
+    return rate > 0.5f ? 0.5f : rate;
+}
+
 static float hand_facing_override(HSD_GObj* gobj, float requested)
 {
     Fighter* fp = GET_FIGHTER(gobj);
@@ -614,7 +719,8 @@ static float hand_facing_override(HSD_GObj* gobj, float requested)
